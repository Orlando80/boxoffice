# Copy to .env for local use. Placeholder values only; never commit real secrets.

# Listen port. Defaults per app: api 4000, web 3000, admin 3001, scanner 3002.
PORT=4000

# Temporal worker connection. An empty TEMPORAL_API_KEY means a plain local
# connection; setting it enables TLS + API key (Temporal Cloud).
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_API_KEY=

# Used by packages/db tooling (drizzle). Placeholder local URL.
DATABASE_URL=postgres://placeholder:placeholder@localhost:5432/placeholder
