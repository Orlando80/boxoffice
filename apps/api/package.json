{
  "name": "@boxoffice/api",
  "private": true,
  "type": "module",
  "exports": {
    "./app": "./src/app.ts",
    "./repository": "./src/repository.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:int": "vitest run --root ../.. --config vitest.int.config.ts apps/api"
  },
  "dependencies": {
    "@boxoffice/contracts": "workspace:*",
    "@boxoffice/db": "workspace:*",
    "drizzle-orm": "^0.45.0",
    "fastify": "^5.5.0",
    "fastify-type-provider-zod": "^7.0.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@boxoffice/config": "workspace:*",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/node": "^24.19.1",
    "testcontainers": "^12.2.0",
    "tsx": "^4.20.0"
  }
}
